---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import site from '../data/site.json';
import { sortVehicles, sortPayloads } from '../lib/fleet';

interface Props {
  current: string; // e.g. "/rockets"
}
const { current } = Astro.props;
const subteams = await getCollection('subteams');
const vehicles = sortVehicles(await getCollection('vehicles'));
const payloads = sortPayloads(await getCollection('payloads'));
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const onRocketsIndex = path === '/rockets';
const onRocketsSection = path === '/rockets' || path.startsWith('/rockets/');
const onSubteamsIndex = path === '/subteams';
const onSubteamsSection = path === '/subteams' || path.startsWith('/subteams/');
const onPayloadsIndex = path === '/payloads';
const onPayloadsSection = path === '/payloads' || path.startsWith('/payloads/');
---

<a class="skip" href="#main">{site.a11y.skipToContent}</a>

<nav id="nav">
  <a class="brand" href="/">
    <Logo />
    <span class="lockup">
      <span class="lockup-name">{site.short}</span>
      <span class="lockup-tag">{site.tagline}</span>
    </span>
  </a>
  <button class="navtoggle" id="navtoggle" aria-expanded="false" aria-controls="navlinks">
    <span class="bars" aria-hidden="true"></span>{site.a11y.menu}
  </button>
  <noscript>
    <style>
      /* Below 980px .navlinks only opens via site.js's click handler on
         #navtoggle. Without JS that panel stays permanently
         visibility:hidden, so every nav link is unreachable on a phone.
         Force the panel static and visible, and hide the now-nonfunctional
         toggle, so the links degrade to always-on instead of gone. */
      @media (max-width: 980px) {
        .navlinks { position: static !important; transform: none !important; visibility: visible !important; }
        .navtoggle { display: none !important; }
      }
    </style>
  </noscript>
  <div class="navlinks" id="navlinks">
    {site.nav.map((item) => {
      if (item.href === '/rockets') {
        return (
          <div class="navitem">
            <a
              href={item.href}
              class:list={['navitem-top', onRocketsSection && 'is-section']}
              aria-current={onRocketsIndex ? 'page' : undefined}
              aria-haspopup="true"
            >{item.label}</a>
            <ul class="navmenu" aria-label="Rockets">
              {vehicles.map(({ data: v }) => (
                <li>
                  <a
                    href={`/rockets/${v.slug}`}
                    aria-current={path === `/rockets/${v.slug}` ? 'page' : undefined}
                  >{v.name}</a>
                </li>
              ))}
            </ul>
          </div>
        );
      }
      if (item.href === '/payloads') {
        return (
          <div class="navitem">
            <a
              href={item.href}
              class:list={['navitem-top', onPayloadsSection && 'is-section']}
              aria-current={onPayloadsIndex ? 'page' : undefined}
              aria-haspopup="true"
            >{item.label}</a>
            <ul class="navmenu" aria-label="Payloads">
              {payloads.map(({ data: p }) => (
                <li>
                  <a
                    href={`/payloads/${p.slug}`}
                    aria-current={path === `/payloads/${p.slug}` ? 'page' : undefined}
                  >{p.name}</a>
                </li>
              ))}
            </ul>
          </div>
        );
      }
      if (item.href === '/subteams') {
        return (
          <div class="navitem">
            <a
              href={item.href}
              class:list={['navitem-top', onSubteamsSection && 'is-section']}
              aria-current={onSubteamsIndex ? 'page' : undefined}
              aria-haspopup="true"
            >{item.label}</a>
            <ul class="navmenu" aria-label="Subteams">
              {subteams.map(({ data: s }) => (
                <li>
                  <a
                    href={`/subteams/${s.slug}`}
                    aria-current={path === `/subteams/${s.slug}` ? 'page' : undefined}
                  >{s.name}</a>
                </li>
              ))}
            </ul>
          </div>
        );
      }
      return (
        <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
      );
    })}
  </div>
</nav>
