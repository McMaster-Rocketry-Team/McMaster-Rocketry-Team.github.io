---
import { getCollection } from 'astro:content';
import { rocketGlyph, riseHeight, shortComp, sortVehicles } from '../lib/fleet';

const vehicles = sortVehicles(await getCollection('vehicles'));
const maxLengthIn = vehicles.reduce((m, { data: v }) => (v.lengthIn ? Math.max(m, v.lengthIn) : m), 1);
---

<div class="lineup reveal-pending">
  {vehicles.map(({ data: v }) => {
    const h = riseHeight(v.lengthIn, maxLengthIn);
    const rise = v.image ? `<img src="${v.image}" alt="" style="height:${h}px;width:auto">` : rocketGlyph(h);
    return (
      <a class={`craft${v.paleArt ? ' pale-art' : ''}`} href={`/rockets/${v.slug}`}>
        <span class="rise" set:html={rise} />
        <span class="val">{v.apogee && <>{v.apogee.toLocaleString()} ft</>}</span>
        <span class="nm"><b>{v.name}</b><span>{shortComp(v.comp)} · {v.year}</span></span>
      </a>
    );
  })}
</div>
<div class="wrap"><div class="baseline"></div></div>
<div class="wrap">
  <div class="fleetnote">
    <span>LC = Launch Canada · SAC = Spaceport America Cup</span>
    <span>Rocket size = relative length, tip to tail</span>
  </div>
</div>
