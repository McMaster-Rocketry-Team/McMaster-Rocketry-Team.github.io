---
import { getCollection } from 'astro:content';
import site from '../data/site.json';
import pages from '../data/pages.json';
import { rocketGlyph, riseHeight, scaleTickTop, scaleTicks, shortComp, sortVehicles, maxRiseH } from '../lib/fleet';

const vehicles = sortVehicles(await getCollection('vehicles'));
const maxLengthIn = vehicles.reduce((m, { data: v }) => (v.lengthIn ? Math.max(m, v.lengthIn) : m), 1);
const ticks = scaleTicks(maxLengthIn);
---

<div class="fleet-stage">
  <div class="fleet-scale" style={`height:${maxRiseH}px`} aria-hidden="true">
    <div class="fleet-scale-rail"></div>
    {ticks.map((inches) => {
      const top = scaleTickTop(inches, maxLengthIn);
      const m = (inches * 0.0254).toFixed(inches >= 100 ? 2 : 1);
      return (
        <span class="fleet-scale-tick" style={`top:${top}px`}>
          <i></i>
          <span>
            {inches === 0 ? '0' : (
              <>
                {inches}&nbsp;in
                <span class="u">{m}&nbsp;m</span>
              </>
            )}
          </span>
        </span>
      );
    })}
  </div>
  <div class="lineup reveal-pending">
    {vehicles.map(({ data: v }) => {
      const h = riseHeight(v.lengthIn, maxLengthIn);
      const rise = v.image
        ? `<img src="${v.image}" alt="" style="--rise:${h}px" loading="lazy">`
        : rocketGlyph(h);
      return (
        <a class={`craft${v.paleArt ? ' pale-art' : ''}${!v.lengthIn ? ' unsized' : ''}`} href={`/rockets/${v.slug}`}>
          <span class="rise" set:html={rise} />
          <span class="val">{v.apogee && <>{v.apogee.toLocaleString()} ft</>}</span>
          <span class="nm">
            <b class="link-fleet">{v.name}</b>
            <span class="meta">{shortComp(v.comp)} · {v.year}</span>
            <span class="go" aria-hidden="true">View →</span>
          </span>
        </a>
      );
    })}
  </div>
</div>
<div class="wrap"><div class="baseline"></div></div>
<div class="wrap">
  <div class="fleetnote">
    <span>{site.abbreviations}</span>
    <span>{pages.rockets.index.fleetNote.scale}</span>
  </div>
</div>
