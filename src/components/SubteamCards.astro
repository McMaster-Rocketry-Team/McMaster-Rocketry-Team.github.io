---
import { getCollection } from 'astro:content';
const subteams = await getCollection('subteams');
---

<div class="cards c4">
  {subteams.map(({ data: s }, i) => (
    <a class="card" href={`/subteams/${s.slug}`}>
      <div>
        <div class="tag">{String(i + 1).padStart(2, '0')}</div>
        <h3>{s.name}</h3>
        <p>{s.blurb}</p>
      </div>
    </a>
  ))}
</div>
