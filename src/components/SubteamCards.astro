---
import { getCollection } from 'astro:content';
import join from '../data/join.json';

const subteams = await getCollection('subteams');
---

<div class="cards c4">
  {subteams.map(({ data: s }) => (
    <a class="card" href={`/subteams/${s.slug}`}>
      <div>
        <h3>{s.name}</h3>
        <p>{s.blurb}</p>
      </div>
    </a>
  ))}
  <a class="card card-cta" href="/join">
    <div><h3>{join.recruitCta.headline}</h3><p>{join.recruitCta.body}</p></div>
  </a>
</div>
