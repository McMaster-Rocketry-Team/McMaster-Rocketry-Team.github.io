---
import { getCollection } from 'astro:content';
const subteams = await getCollection('subteams');
---

<div class="cards c4">
  {subteams.map(({ data: s }) => (
    <a class="card" href={`/subteams/${s.slug}`}>
      <div>
        <h3>{s.name}</h3>
        <p>{s.blurb}</p>
      </div>
    </a>
  ))}
  <a class="card card-cta" href="/join">
    <div><h3>Want to learn more?</h3><p>Come to Clubsfest or Facultyfest and talk with the team.</p></div>
  </a>
</div>
