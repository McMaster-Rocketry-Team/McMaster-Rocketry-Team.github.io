---
import TodoBadge from './TodoBadge.astro';
import { mailHref, hasRealEmail } from '../lib/site';
import join from '../data/join.json';
---

<section class="cta">
  <div class="wrap">
    <div class="tag">{join.cta.tag}</div>
    <h2>{join.cta.headline}</h2>
    <p>{join.cta.body}</p>
    <p class="fine">{join.cta.fine}</p>
    <div class="btnrow">
      <a class="btn solid" href="/join">{join.cta.buttons.join}</a>
      <a class="btn" href="/sponsors">{join.cta.buttons.sponsors}</a>
      <a class="btn" href={mailHref()}>{join.cta.buttons.email}</a>
      {!hasRealEmail() && <TodoBadge label="real team email" />}
    </div>
  </div>
</section>
