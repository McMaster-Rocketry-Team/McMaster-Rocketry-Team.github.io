---
import site from '../data/site.json';
import TodoBadge from './TodoBadge.astro';
import Logo from './Logo.astro';
import { fill } from '../lib/copy';
import { mailHref, hasRealEmail } from '../lib/site';

const socials = [
  ['Instagram', site.social.instagram],
  ['Discord', site.social.discord],
  ['LinkedIn', site.social.linkedin],
] as const;
const footerIntro = fill(site.footerIntro, { org: site.org, city: site.city });
---

<footer class="site">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <div class="foot-brand">
          <Logo />
          <div class="lockup lockup--foot">
            <h2 class="lockup-name">{site.name}</h2>
            <p class="lockup-tag">{site.tagline}</p>
          </div>
        </div>
        <p class="foot-intro">{footerIntro}</p>
        <p class="foot-contact">
          <a href={mailHref()}>{site.email || 'TODO@macrocketry.ca'}</a>
          {!hasRealEmail() && <> <TodoBadge label="real team email" /></>}
        </p>
      </div>
      <div>
        <h2 class="fh">{site.footerContact.teamHeading}</h2>
        <ul role="list">
          {site.footerNav.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="fh">{site.footerContact.touchHeading}</h2>
        <ul role="list">
          <li><a href="/sponsors">{site.footerContact.sponsorship}</a></li>
          <li>
            <a href={mailHref()}>{site.footerContact.email}</a>
            {!hasRealEmail() && <> <TodoBadge label="real team email" /></>}
          </li>
          {socials.map(([label, href]) => (
            <li>
              <a href={href || `https://${label.toLowerCase()}.com/TODO`}>{label}</a>
              {!href && <> <TodoBadge label="link" /></>}
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="foot-note">
      <span>© {site.copyrightYear} {site.name} · {site.org} · {site.city}</span>
    </div>
  </div>
</footer>
