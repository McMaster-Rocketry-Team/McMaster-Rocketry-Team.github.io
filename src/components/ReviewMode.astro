---
// Working-review overlay: flags every prose block (headings, paragraphs, list
// items, captions, and short factual leaf text) inside <main> with a dashed
// marker, separate from TodoBadge (which means "content missing"). This means
// "content is written but Robin has not verified it against a source yet".
// Click a flagged block to check it off; state persists per page in
// localStorage so a review session survives reloads.
// Self-contained: delete this file and its <ReviewMode /> line in
// BaseLayout.astro to remove before launch.
//
// A page can lock specific blocks in for good by passing `reviewLocked`
// indices to BaseLayout (stored as JSON in #main's data-rv-locked). Locked
// blocks get no data-review attribute, no outline, and no click handler: they
// render as plain content regardless of what's in localStorage, so a cleared
// browser or a different machine can't un-confirm them. Indices come from the
// same scan order below, so only lock a block after confirming its index in
// a live session; a later structural change to the page can shift indices.
---

<style is:global>
[data-review]{position:relative;outline:1.5px dashed var(--amber);outline-offset:4px;cursor:pointer}
[data-review]::before{content:"?";position:absolute;top:-9px;left:-9px;width:16px;height:16px;
  border-radius:50%;background:var(--amber);color:var(--graphite-900);font:700 10px/16px var(--font-mono);
  text-align:center;pointer-events:none;z-index:2}
[data-review].rv-verified{outline-style:solid;outline-color:var(--rule-light);opacity:.6}
[data-review].rv-verified::before{content:"\2713";background:var(--graphite-900);color:var(--white)}
#rv-panel{position:fixed;right:16px;bottom:16px;z-index:999;background:var(--graphite-900);color:var(--white);
  font:600 12px/1.3 var(--font-mono);padding:10px 14px;border-radius:6px;box-shadow:0 4px 18px rgba(0,0,0,.35);
  display:flex;align-items:center;gap:10px}
#rv-panel button{font:600 11px var(--font-mono);background:var(--ignition);color:var(--white);border:0;
  padding:5px 9px;border-radius:3px;cursor:pointer}
</style>

<div id="rv-panel"><span id="rv-count">Review: 0/0</span><button id="rv-reset" type="button">Reset page</button></div>

<script is:inline>
(function () {
  function init() {
    var root = document.getElementById('main');
    if (!root) return;
    var locked;
    try { locked = new Set(JSON.parse(root.getAttribute('data-rv-locked') || '[]')); } catch (e) { locked = new Set(); }
    var INLINE = { A: 1, B: 1, I: 1, EM: 1, STRONG: 1, SPAN: 1, BR: 1, SUP: 1, SUB: 1, U: 1 };
    var candidates = [];
    root.querySelectorAll('p,h1,h2,h3,h4,h5,li,figcaption,blockquote,dt,dd').forEach(function (el) {
      candidates.push(el);
    });
    root.querySelectorAll('div,span,b,i').forEach(function (el) {
      for (var i = 0; i < el.children.length; i++) {
        if (!INLINE[el.children[i].tagName]) return;
      }
      // A div/span whose only text lives inside <a>/<button> descendants is a
      // button row or link wrapper, not prose: drop the links, see what's left.
      var clone = el.cloneNode(true);
      clone.querySelectorAll('a,button').forEach(function (a) { a.remove(); });
      if ((clone.textContent || '').trim().length < 2) return;
      candidates.push(el);
    });
    var flagged = candidates.filter(function (el) {
      if (el.closest('button,#rv-panel')) return false;
      if (el.closest('[aria-hidden="true"]')) return false;
      if ((el.textContent || '').trim().length < 2) return false;
      return true;
    });
    var deduped = flagged.filter(function (el) {
      return !flagged.some(function (other) { return other !== el && other.contains(el); });
    });
    var path = location.pathname;
    var stored;
    try { stored = JSON.parse(localStorage.getItem('mrt-review:' + path) || '[]'); } catch (e) { stored = []; }
    var verifiedSet = new Set(stored);
    deduped.forEach(function (el, i) {
      if (locked.has(i)) return;
      el.setAttribute('data-review', i);
      if (verifiedSet.has(i)) el.classList.add('rv-verified');
      el.addEventListener('click', function (e) {
        var innerLink = e.target.closest('a,button,input');
        if (innerLink && el.contains(innerLink) && innerLink !== el) return;
        e.preventDefault();
        e.stopPropagation();
        el.classList.toggle('rv-verified');
        save();
      });
    });
    function save() {
      var idx = [];
      deduped.forEach(function (el, i) { if (el.classList.contains('rv-verified')) idx.push(i); });
      localStorage.setItem('mrt-review:' + path, JSON.stringify(idx));
      updateCount();
    }
    function updateCount() {
      var unlocked = deduped.filter(function (el, i) { return !locked.has(i); });
      var done = unlocked.filter(function (el) { return el.classList.contains('rv-verified'); }).length;
      var countEl = document.getElementById('rv-count');
      if (countEl) countEl.textContent = 'Review: ' + done + '/' + unlocked.length;
    }
    updateCount();
    var resetBtn = document.getElementById('rv-reset');
    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        localStorage.removeItem('mrt-review:' + path);
        deduped.forEach(function (el) { el.classList.remove('rv-verified'); });
        updateCount();
      });
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
