---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PayloadLineup from '../../components/PayloadLineup.astro';
import PayloadStat from '../../components/PayloadStat.astro';
import CtaBand from '../../components/CtaBand.astro';
---

<BaseLayout
  title="Payloads"
  description="The experiments the McMaster Rocketry Team has designed, built and flown."
  current="/payloads"
  reviewLocked={[]}
>
<header class="phead">
  <span class="crosshair tl" aria-hidden="true"></span>
  <span class="crosshair br" aria-hidden="true"></span>
  <div class="wrap">
    <div class="tag">Payloads</div>
    <h1>What we fly<br>the rocket for.</h1>
    <p class="lede">Most years, the payload is the reason the rocket exists at all. Every one the team has flown.</p>
  </div>
</header>

<section class="paper fleet">
  <span class="crosshair tl" aria-hidden="true"></span>
  <span class="crosshair br" aria-hidden="true"></span>
  <div class="wrap">
    <div class="shead">
      <div><div class="tag">All payloads</div><h2>By year.</h2></div>
      <div class="statline"><PayloadStat /></div>
    </div>
    <PayloadLineup />
  </div>
</section>

<CtaBand />
</BaseLayout>
