---
import PageHead from '../../components/PageHead.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PayloadLineup from '../../components/PayloadLineup.astro';
import PayloadStat from '../../components/PayloadStat.astro';
import CtaBand from '../../components/CtaBand.astro';
import { payloadsHeadline } from '../../lib/copy';
import { getCollection } from 'astro:content';
import pages from '../../data/pages.json';

const page = pages.payloads.index;
const payloads = await getCollection('payloads');
const pWins = payloads.filter((p) => p.data.result?.startsWith('1st')).length;
---

<BaseLayout
  title={page.title}
  description={page.description}
  current="/payloads"
  reviewLocked={Array.from({ length: 6 }, (_, i) => i)}
>
<PageHead title={payloadsHeadline(payloads.length, pWins)} lede={page.lede} />

<section class="paper fleet">
  <div class="wrap">
    <div class="shead">
      <div><h2>{page.section.headline}</h2></div>
      <div class="statline"><PayloadStat /></div>
    </div>
    <PayloadLineup />
  </div>
</section>

<CtaBand />
</BaseLayout>
