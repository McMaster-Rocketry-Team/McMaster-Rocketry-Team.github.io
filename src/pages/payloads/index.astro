---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PayloadLineup from '../../components/PayloadLineup.astro';
import PayloadStat from '../../components/PayloadStat.astro';
import CtaBand from '../../components/CtaBand.astro';
import { payloadsHeadline } from '../../lib/copy';
import { getCollection } from 'astro:content';
import pages from '../../data/pages.json';

const page = pages.payloads.index;
const payloads = await getCollection('payloads');
const pWins = payloads.filter((p) => p.data.result?.startsWith('1st')).length;
---

<BaseLayout
  title={page.title}
  description={page.description}
  current="/payloads"
  reviewLocked={Array.from({ length: 6 }, (_, i) => i)}
>
<header class="phead">
  <span class="crosshair tl" aria-hidden="true"></span>
  <span class="crosshair br" aria-hidden="true"></span>
  <div class="wrap">
    <div class="tag">{page.tag}</div>
    <h1>{payloadsHeadline(payloads.length, pWins)}</h1>
    <p class="lede">{page.lede}</p>
  </div>
</header>

<section class="paper fleet">
  <span class="crosshair tl" aria-hidden="true"></span>
  <span class="crosshair br" aria-hidden="true"></span>
  <div class="wrap">
    <div class="shead">
      <div><div class="tag">{page.section.tag}</div><h2>{page.section.headline}</h2></div>
      <div class="statline"><PayloadStat /></div>
    </div>
    <PayloadLineup />
  </div>
</section>

<CtaBand />
</BaseLayout>
