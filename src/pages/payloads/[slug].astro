---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TodoBadge from '../../components/TodoBadge.astro';
import CtaBand from '../../components/CtaBand.astro';

import { sortPayloads } from '../../lib/fleet';
import pages from '../../data/pages.json';
import site from '../../data/site.json';

export async function getStaticPaths() {
  const payloads = sortPayloads(await getCollection('payloads'));
  const vehicles = await getCollection('vehicles');
  return payloads.map((p) => ({ params: { slug: p.data.slug }, props: { payloads, vehicles, p: p.data } }));
}

const { payloads, vehicles, p } = Astro.props;
const template = pages.payloads.template;
const vehicle = p.vehicle ? vehicles.find((v) => v.data.slug === p.vehicle)?.data : null;

const i = payloads.findIndex((x) => x.data.slug === p.slug);
const prev = i > 0 ? payloads[i - 1].data : null;
const next = i < payloads.length - 1 ? payloads[i + 1].data : null;

const detailParagraphs = p.detail ? p.detail.split(/\n\n+/) : [];

// After hero (dark) + specs (paper) + detail (dark), alternate paper/dark for optional sections.
let sectionTone = 0;
function sectionClass(): string | undefined {
  const paper = sectionTone % 2 === 0;
  sectionTone += 1;
  return paper ? 'paper' : undefined;
}
---

<BaseLayout title={p.name} description={`${p.name}: McMaster Rocketry's ${p.year} ${p.comp} payload.`} current="/payloads" reviewLocked={p.reviewLocked}>
<header class={p.heroImage ? 'phead has-hero' : 'phead'} style={p.heroImage ? `--hero-img:url(${p.heroImage})${p.heroImagePosition ? `;--hero-pos:${p.heroImagePosition}` : ''}` : undefined}>
  <span class="crosshair tl" aria-hidden="true"></span>
  <span class="crosshair br" aria-hidden="true"></span>
  <div class="wrap">
    {p.heroImage ? (
      <div class="herobox">
        <div class="tag">Payload · {p.year} · {p.comp}</div>
        <h1>{p.name}</h1>
        <p class="lede">{p.summary}</p>
      </div>
    ) : (
      <>
        <div class="tag">Payload · {p.year} · {p.comp}</div>
        <h1>{p.name}</h1>
        <p class="lede">{p.summary}</p>
      </>
    )}
  </div>
</header>

<section class="paper">
  <div class="wrap">
  {p.specs && p.specs.length > 0 ? (
    <div class="shead">
      <div><div class="tag">{template.specs.tag}</div><h2>{template.specs.headline}</h2></div>
    </div>
  ) : null}
    <dl class="dl">
      {p.specs && p.specs.map((row) => (
        <div>
          <dt>{row.label}</dt>
          <dd>{row.value}</dd>
        </div>
      ))}
      <div>
        <dt>{template.labels.vehicle}</dt>
        {vehicle ? <dd><a class="link-fleet" href={`/rockets/${vehicle.slug}`}>{vehicle.name}</a></dd> : <dd class="nodata">{site.copy.notPublished}</dd>}
      </div>
      <div>
        <dt>{template.labels.result}</dt>
        {p.result ? <dd>{p.result}</dd> : <dd class="nodata">{site.copy.notPublished}</dd>}
      </div>
    </dl>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="subteam-intro payload-intro">
      <div>
        <div class="shead" style="margin-top:0">
          <div><div class="tag">{template.payload.tag}</div><h2>{template.payload.headline}</h2></div>
        </div>
        <div class="prose prose--follow">
          {detailParagraphs.length > 0 ? detailParagraphs.map((para) => <p>{para}</p>) : (
            <p>No write-up for this payload yet. <TodoBadge label="payload description" /></p>
          )}
        </div>
      </div>
      {p.render && (
        <figure class="subteam-shot payload-render">
          <img src={p.render.src} alt={p.render.alt} loading="lazy" />
        </figure>
      )}
    </div>
  </div>
</section>

{p.blocks && p.blocks.map((block) => (
  <section class={sectionClass()}>
    <div class="wrap">
      <div class="subteam-intro">
        <div>
          <div class="shead" style="margin-top:0">
            <div><div class="tag">{block.tag}</div><h2>{block.heading}</h2></div>
          </div>
          <div class="prose prose--follow">
            <p>{block.body}</p>
          </div>
        </div>
        {block.parts && block.parts.length > 0 ? (
          <div class="bus-parts">
            <div class="bus-parts__bulkheads">
              {block.parts.filter((part) => part.role === 'bulkhead').map((part) => (
                <figure class="bus-part">
                  <img src={part.src} alt={part.alt} loading="lazy" />
                </figure>
              ))}
            </div>
            {block.parts.filter((part) => part.role === 'strut').map((part) => (
              <div class="bus-parts__struts">
                {Array.from({ length: part.count ?? 1 }).map(() => (
                  <figure class="bus-part bus-part--strut">
                    <img src={part.src} alt={part.alt} loading="lazy" />
                  </figure>
                ))}
              </div>
            ))}
          </div>
        ) : block.image ? (
          <figure class="product-aside">
            <img src={block.image} alt={block.imageAlt ?? ''} loading="lazy" />
          </figure>
        ) : null}
      </div>
    </div>
  </section>
))}

{p.procedure && p.procedure.length > 0 && (
  <section class={sectionClass()}>
    <div class="wrap">
      <div class="shead">
        <div><div class="tag">{template.procedure.tag}</div><h2>{template.procedure.headline}</h2></div>
      </div>
      <ol class="procedure-list">
        {p.procedure.map((step) => <li>{step}</li>)}
      </ol>
    </div>
  </section>
)}

{p.electronics && p.electronics.length > 0 && (
  <section class={sectionClass()}>
    <div class="wrap">
      <div class="shead">
        <div><div class="tag">{template.electronics.tag}</div><h2>{template.electronics.headline}</h2></div>
      </div>
      <ul class="module-grid">
        {p.electronics.map((mod) => (
          <li class="module-card">
            <div class="module-card__ph"><img src={mod.image} alt={mod.alt} loading="lazy" /></div>
            <div class="module-card__body">
              <h3>{mod.name}</h3>
              <p>{mod.role}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

{p.poster && (
  <section class={sectionClass()}>
    <div class="wrap">
      <div class="shead">
        <div><div class="tag">{template.poster.tag}</div><h2>{template.poster.headline}</h2></div>
      </div>
      <figure class="poster-figure">
        <img src={p.poster} alt={p.posterAlt ?? `${p.name} competition poster`} loading="lazy" />
      </figure>
    </div>
  </section>
)}

<section class={sectionClass()}>
  <div class="wrap">
    <div class="shead">
      <div><div class="tag">{template.gallery.tag}</div><h2>{template.gallery.headline}</h2></div>
    </div>
    <div class="gallery">
      {p.photos && p.photos.length > 0 ? p.photos.map((photo) => (
        <figure><div class={`ph${photo.contain ? ' ph-is-product' : ''}`} style={photo.ratio ? `--ph-ratio:${photo.ratio}` : undefined}><img src={photo.src} alt={photo.alt} loading="lazy" /></div>
          {photo.caption && <figcaption>{photo.caption}</figcaption>}</figure>
      )) : (<>
        <figure><div class="ph"><span>Photo slot: bench testing<br />TODO</span></div>
          <figcaption>TODO: caption.</figcaption></figure>
        <figure><div class="ph"><span>Photo slot: integration<br />TODO</span></div>
          <figcaption>TODO: caption.</figcaption></figure>
        <figure><div class="ph"><span>Photo slot: on the pad<br />TODO</span></div>
          <figcaption>TODO: caption.</figcaption></figure>
        <figure><div class="ph"><span>Photo slot: recovered<br />TODO</span></div>
          <figcaption>TODO: caption.</figcaption></figure>
      </>)}
    </div>
    <div class="btnrow">
      {prev && <a class="btn" href={`/payloads/${prev.slug}`}><span aria-hidden="true">&larr;</span> {prev.name}</a>}
      <a class="btn" href="/payloads">{template.nav.all}</a>
      {next && <a class="btn" href={`/payloads/${next.slug}`}>{next.name} <span aria-hidden="true">&rarr;</span></a>}
    </div>
  </div>
</section>

<CtaBand />
</BaseLayout>
