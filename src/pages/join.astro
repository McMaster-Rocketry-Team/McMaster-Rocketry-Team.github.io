---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import TodoBadge from '../components/TodoBadge.astro';
import { mailHref } from '../lib/site';
import join from '../data/join.json';
import site from '../data/site.json';

const applyHref = join.applyHref || mailHref('Application');
const sections = join.sections;
---

<BaseLayout
  title="Join us"
  description="How to join the McMaster Rocketry Team. No experience required."
  current="/join"
  reviewLocked={Array.from({ length: 33 }, (_, i) => i)}
>
<header class="phead has-hero has-hero--wide" style="--hero-img:url(/media/join-hero.webp)">
  <span class="crosshair tl" aria-hidden="true"></span>
  <span class="crosshair br" aria-hidden="true"></span>
  <div class="wrap">
    <div class="herobox">
      <div class="tag">{join.hero.tag}</div>
      <h1>{join.hero.headline[0]}<br>{join.hero.headline[1]}</h1>
      <p class="lede">{join.hero.lede}</p>
    </div>
  </div>
</header>

<section class="paper">
  <div class="wrap">
    <div class="shead">
      <div><div class="tag">{sections.howItWorks.tag}</div><h2>{sections.howItWorks.headline}</h2></div>
      <p>{sections.howItWorks.lede}</p>
    </div>
    <ol class="steps" role="list">
      {join.steps.map((s) => (
        <li><h3>{s.title}</h3><p>{s.body} {s.todo && <TodoBadge label={s.todo} />}</p></li>
      ))}
    </ol>
    <div class="btnrow">
      <a class="btn solid" href={applyHref}>{join.buttons.apply}</a>
      {!join.applyHref && <TodoBadge label="swap for form URL" />}
      {site.social.discord
        ? <a class="btn" href={site.social.discord}>{join.buttons.discord}</a>
        : <><a class="btn" href="#">{join.buttons.discord}</a> <TodoBadge label="swap for the real invite" /></>}
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="shead">
      <div><div class="tag">{sections.dates.tag}</div><h2>{sections.dates.headline}</h2></div>
      <p>{sections.dates.lede}</p>
    </div>
    <dl class="dl">
      {join.dates.map((d) => (
        <div>
          <dt>{d.label}</dt>
          <dd class={d.note ? undefined : 'nodata'}>
            {d.note ?? 'TODO'}
            {'detail' in d && d.detail ? <small>{d.detail}</small> : null}
            {'todo' in d && d.todo ? <TodoBadge label={d.todo} /> : null}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<section class="paper">
  <div class="wrap">
    <div class="shead">
      <div><div class="tag">{sections.faq.tag}</div><h2>{sections.faq.headline}</h2></div>
      <p>{sections.faq.lede}</p>
    </div>
    <div class="faq">
      {join.faq.map((f) => (
        <details>
          <summary><h3>{f.q}</h3></summary>
          {f.a ? (
            <p class="a">{f.a} {f.todo && <TodoBadge label={f.todo} />}</p>
          ) : (
            <p class="a"><TodoBadge label={f.todo || 'answer this'} /></p>
          )}
        </details>
      ))}
    </div>
  </div>
</section>

<CtaBand />
</BaseLayout>
