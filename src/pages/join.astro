---
import PageHead from '../components/PageHead.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import ClosedBtn from '../components/ClosedBtn.astro';
import join from '../data/join.json';
import site from '../data/site.json';

const sections = join.sections;
---

<BaseLayout
  title="Join us"
  description="How to join the McMaster Rocketry Team. No experience required."
  current="/join"
  reviewLocked={Array.from({ length: 33 }, (_, i) => i)}
>
<PageHead title={join.hero.headline} lede={join.hero.lede} image="/media/join-hero.webp" wide />

<section class="paper">
  <div class="wrap">
    <div class="shead">
      <div><h2>{sections.howItWorks.headline}</h2></div>
      <p>{sections.howItWorks.lede}</p>
    </div>
    <ol class="steps" role="list">
      {join.steps.map((s) => (
        <li><h3>{s.title}</h3><p>{s.body}</p></li>
      ))}
    </ol>
    <div class="btnrow">
      {join.applicationsOpen
        ? <a class="btn solid" href={join.applyHref}>{join.buttons.apply}</a>
        : <ClosedBtn label={join.buttons.apply} />}
      <a class="btn" href={site.social.instagram}>{join.buttons.instagram}</a>
      <a class="btn" href={site.social.discord}>{join.buttons.discord}</a>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="shead">
      <div><h2>{sections.dates.headline}</h2></div>
      <p>{sections.dates.lede}</p>
    </div>
    <dl class="dl c4">
      {join.dates.map((d) => (
        <div>
          <dt>{d.label}</dt>
          <dd>
            {d.note}
            {d.detail ? <small>{d.detail}</small> : null}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<section class="paper">
  <div class="wrap">
    <div class="shead">
      <div><h2>{sections.faq.headline}</h2></div>
      <p>{sections.faq.lede}</p>
    </div>
    <div class="faq">
      {join.faq.map((f) => (
        <details>
          <summary><h3>{f.q}</h3></summary>
          <p class="a">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<CtaBand />
</BaseLayout>
