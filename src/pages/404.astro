---
import PageHead from '../components/PageHead.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import pages from '../data/pages.json';
---

<BaseLayout
  title={pages.notFound.title}
  description={pages.notFound.description}
  current="/404"
  reviewLocked={[0, 1]}
>
<PageHead title={pages.notFound.headline} lede={pages.notFound.lede} image="/media/404-sunset.webp" wide>
  <div class="btnrow">
    <a class="btn solid" href="/">{pages.notFound.cta.home}</a>
    <a class="btn" href="/join">{pages.notFound.cta.join}</a>
  </div>
</PageHead>
</BaseLayout>
