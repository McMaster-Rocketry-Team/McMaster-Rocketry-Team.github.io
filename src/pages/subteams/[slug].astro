---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TodoBadge from '../../components/TodoBadge.astro';
import CtaBand from '../../components/CtaBand.astro';
import { mailHref } from '../../lib/site';
import members from '../../data/members.json';

export async function getStaticPaths() {
  const subteams = await getCollection('subteams');
  return subteams.map((s) => ({ params: { slug: s.data.slug }, props: { subteams, t: s.data } }));
}

const { subteams, t } = Astro.props;
const others = subteams.filter((x) => x.data.slug !== t.slug);
const leads = members.leads.filter((l) => l.subteam === t.slug);
---

<BaseLayout title={t.name} description={t.blurb} current="/subteams">
<header class="phead">
  <span class="crosshair tl" aria-hidden="true"></span>
  <span class="crosshair br" aria-hidden="true"></span>
  <div class="wrap">
    <div class="tag">Subteams</div>
    <h1>{t.name}</h1>
    <p class="lede">{t.blurb}</p>
  </div>
</header>

<section class="paper">
  <div class="wrap">
    <div class="prose">
      {t.detail ? <p>{t.detail}</p> : <><p>{t.blurb}</p><p><TodoBadge label="full subteam description" /></p></>}
    </div>

    <div class="cards c3 cards--follow">
      <div class="card">
        <div>
          <div class="tag">What you'd do</div>
          <h3>First term</h3>
          <p>{t.first || <TodoBadge label="what a first-term member actually does" />}</p>
        </div>
      </div>
      <div class="card">
        <div>
          <div class="tag">Skills that help</div>
          <h3>Useful, not required</h3>
          <p>{t.skills || <TodoBadge label="useful-but-not-required skills" />}</p>
        </div>
      </div>
      <div class="card">
        <div>
          <div class="tag">Time</div>
          <h3>{t.hours || 'TODO'}</h3>
          <p>More in the four weeks before a launch, much less over exams. We plan around
            your term, not the other way round.
            <span class="todo" aria-hidden="true">TODO: confirm real commitment</span></p>
        </div>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="shead">
      <div><div class="tag">The others</div><h2>Every other subteam.</h2></div>
      <p>Each one takes members with no experience every term.</p>
    </div>
    <div class="cards c4">
      {others.map((x) => (
        <a class="card" href={`/subteams/${x.data.slug}`}>
          <div><h3>{x.data.name}</h3><p>{x.data.blurb}</p></div>
        </a>
      ))}
    </div>

    <div class="shead shead--follow">
      <div><div class="tag">Leads</div><h2>Who runs it.</h2></div>
      <p>Named leads, so you know who to ask.</p>
    </div>
    <div class="cards c3">
      {leads.length ? leads.map((lead) => (
        <div class="card"><div>
          <div class="tag">Subteam lead</div>
          <h3>{lead.name}</h3>
          <p>
            {lead.programme && lead.year ? (
              <>{lead.year} · {lead.programme}. </>
            ) : (
              <TodoBadge label="programme, year, and what they work on" />
            )}
            {' '}<a class="link-underline" href={mailHref()}>Email</a>
          </p>
        </div></div>
      )) : (
        <div class="card"><div>
          <div class="tag">Subteam lead</div>
          <h3>TODO: name</h3>
          <p>Year and programme. One sentence on what they work on.</p>
        </div></div>
      )}
      <div class="card"><div>
        <div class="tag">Recruiting</div><h3>Open now</h3>
        <p>We take new members every term, and we don't expect experience.</p>
        <div class="btnrow"><a class="btn" href="/join">How to join</a></div>
      </div></div>
    </div>
  </div>
</section>

<CtaBand />
</BaseLayout>
