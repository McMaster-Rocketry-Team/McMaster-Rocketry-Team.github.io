---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TodoBadge from '../../components/TodoBadge.astro';
import CtaBand from '../../components/CtaBand.astro';
import { mailHref } from '../../lib/site';
import { sortPayloads } from '../../lib/fleet';
import members from '../../data/members.json';

export async function getStaticPaths() {
  const subteams = await getCollection('subteams');
  const payloads = sortPayloads(await getCollection('payloads'));
  return subteams.map((s) => ({ params: { slug: s.data.slug }, props: { subteams, payloads, t: s.data } }));
}

const { subteams, payloads, t } = Astro.props;
const others = subteams.filter((x) => x.data.slug !== t.slug);
const leads = members.leads.filter((l) => l.subteam === t.slug);
const leadSlots = (leads.length || 1) + 1;
const leadCols = leadSlots % 3 === 0 ? 'c3' : 'c2';
---

<BaseLayout title={t.name} description={t.blurb} current="/subteams" reviewLocked={t.reviewLocked}>
<header class={t.heroImage ? 'phead has-hero' : 'phead'} style={t.heroImage ? `--hero-img:url(${t.heroImage})${t.heroImagePosition ? `;--hero-pos:${t.heroImagePosition}` : ''}` : undefined}>
  <span class="crosshair tl" aria-hidden="true"></span>
  <span class="crosshair br" aria-hidden="true"></span>
  <div class="wrap">
    {t.heroImage ? (
      <div class="herobox">
        <div class="tag">Subteams</div>
        <h1>{t.name}</h1>
        <p class="lede">{t.blurb}</p>
      </div>
    ) : (
      <>
        <div class="tag">Subteams</div>
        <h1>{t.name}</h1>
        <p class="lede">{t.blurb}</p>
      </>
    )}
  </div>
</header>

<section class="paper">
  <div class="wrap">
    <div class="subteam-intro">
      <div class="prose">
        {t.detail ? <p>{t.detail}</p> : <><p>{t.blurb}</p><p><TodoBadge label="full subteam description" /></p></>}
      </div>
      <figure class="subteam-shot">
        <div class="tag">{t.photoTag || 'In the shop'}</div>
        {t.photo || t.photoVideo ? (
          <div class={`ph${t.photoIsProduct ? ' ph-is-product' : ''}`}>
            {t.photoVideo ? (
              <video
                src={t.photoVideo}
                poster={t.photo ?? undefined}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                aria-label={t.photoAlt || ''}
              />
            ) : (
              <img src={t.photo} alt={t.photoAlt || ''} loading="lazy" />
            )}
          </div>
        ) : (
          <div class="ph"><span>Photo slot: work in progress<br />TODO</span></div>
        )}
        {(t.photo || t.photoVideo) && t.photoCaption ? (
          <figcaption>{t.photoCaption}</figcaption>
        ) : null}
      </figure>
    </div>

    <div class="cards c3 cards--follow">
      <div class="card">
        <div>
          <div class="tag">What you'd do</div>
          <h3>First year</h3>
          <p>{t.first || <TodoBadge label="what a first-term member actually does" />}</p>
        </div>
      </div>
      <div class="card">
        <div>
          <div class="tag">Skills that help</div>
          <h3>Useful, not required</h3>
          <p>{t.skills || <TodoBadge label="useful-but-not-required skills" />}</p>
        </div>
      </div>
      <div class="card">
        <div>
          <div class="tag">Time</div>
          <h3>{t.hours || 'TODO'}</h3>
        </div>
      </div>
    </div>
  </div>
</section>

{t.slug === 'payload' && payloads.length > 0 && (
  <section class="paper">
    <div class="wrap">
      <div class="shead">
        <div><div class="tag">Recent payloads</div><h2>What we've flown.</h2></div>
      </div>
      <div class="cards c2">
        {payloads.map((p) => (
          <a class="card" href={`/payloads/${p.data.slug}`}>
            <div>
              <div class="tag">{p.data.year} · {p.data.comp}</div>
              <h3>{p.data.name}</h3>
              <p>{p.data.summary}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<section>
  <div class="wrap">
    <div class="shead">
      <div><div class="tag">The others</div><h2>Every other subteam.</h2></div>
      <p>Each one takes members with no experience every term.</p>
    </div>
    <div class="cards c3">
      {others.map((x) => (
        <a class="card" href={`/subteams/${x.data.slug}`}>
          <div><h3>{x.data.name}</h3><p>{x.data.blurb}</p></div>
        </a>
      ))}
    </div>

    <div class="shead shead--follow">
      <div><div class="tag">Leads</div><h2>Who runs it.</h2></div>
      <p>Named leads, so you know who to ask.</p>
    </div>
    <div class={`cards ${leadCols}`}>
      {leads.length ? leads.map((lead) => (
        <div class="card"><div>
          <div class="tag">Subteam lead</div>
          <h3>{lead.name}</h3>
          <p>
            {lead.programme && lead.year ? (
              <>{lead.year} · {lead.programme}. </>
            ) : (
              <TodoBadge label="programme, year, and what they work on" />
            )}
            {' '}<a class="link-underline" href={mailHref()}>Email</a>
          </p>
        </div></div>
      )) : (
        <div class="card"><div>
          <div class="tag">Subteam lead</div>
          <h3>TODO: name</h3>
          <p>Year and programme. One sentence on what they work on.</p>
        </div></div>
      )}
      <a class="card" href="/join">
        <div>
          <div class="tag">Recruiting</div>
          <h3>Join us</h3>
          <p>How to apply, and when.</p>
        </div>
      </a>
    </div>
  </div>
</section>

<CtaBand />
</BaseLayout>
