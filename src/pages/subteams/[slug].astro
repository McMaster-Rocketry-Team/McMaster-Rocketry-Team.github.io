---
import { imageSize } from '../../lib/imagesize';
import PageHead from '../../components/PageHead.astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TodoBadge from '../../components/TodoBadge.astro';
import CtaBand from '../../components/CtaBand.astro';
import { mailHref } from '../../lib/site';
import { sortPayloads } from '../../lib/fleet';
import members from '../../data/members.json';
import pages from '../../data/pages.json';
import site from '../../data/site.json';

export async function getStaticPaths() {
  const subteams = await getCollection('subteams');
  const payloads = sortPayloads(await getCollection('payloads'));
  return subteams.map((s) => ({ params: { slug: s.data.slug }, props: { subteams, payloads, t: s.data } }));
}

const { subteams, payloads, t } = Astro.props;
const template = pages.subteams.template;
const others = subteams.filter((x) => x.data.slug !== t.slug);
const leads = members.leads.filter((l) => l.subteam === t.slug);
const leadSlots = (leads.length || 1) + 1;
const leadCols = leadSlots % 3 === 0 ? 'c3' : 'c2';
---

<BaseLayout title={t.name} description={t.blurb} current="/subteams" reviewLocked={t.reviewLocked}>
<PageHead title={t.name} lede={t.blurb} image={t.heroImage} imagePos={t.heroImagePosition} />

<section class="paper">
  <div class="wrap">
    <div class="subteam-intro">
      <div class="prose">
        {t.detail ? <p>{t.detail}</p> : <><p>{t.blurb}</p><p><TodoBadge label="full subteam description" /></p></>}
      </div>
      <figure class="subteam-shot">
        {t.photo || t.photoVideo ? (
          <div class={`ph${t.photoIsProduct ? ' ph-is-product' : ''}`}>
            {t.photoVideo ? (
              <>
                <video
                  class="lazyvid"
                  poster={t.photo ?? undefined}
                  muted
                  loop
                  playsinline
                  preload="none"
                  data-src={t.photoVideo}
                  aria-label={t.photoAlt || ''}
                ></video>
                <button class="vidtoggle" type="button">{site.a11y.pauseVideo}</button>
              </>
            ) : (
              <img src={t.photo} {...imageSize(t.photo)} alt={t.photoAlt || ''} loading="lazy" />
            )}
          </div>
        ) : (
          <div class="ph"><span>Photo slot: work in progress<br />TODO</span></div>
        )}
        {(t.photo || t.photoVideo) && t.photoCaption ? (
          <figcaption>{t.photoCaption}</figcaption>
        ) : null}
      </figure>
    </div>

    <div class="cards c3 cards--follow">
      <div class="card">
        <div>
          <h3>{template.cards.firstYear.headline}</h3>
          <p>{t.first || <TodoBadge label="what a first-term member actually does" />}</p>
        </div>
      </div>
      <div class="card">
        <div>
          <h3>{template.cards.skills.headline}</h3>
          <p>{t.skills || <TodoBadge label="useful-but-not-required skills" />}</p>
        </div>
      </div>
      <div class="card">
        <div>
          <h3>{template.cards.time.headline}</h3>
          <p>{t.hours || 'TODO'}</p>
        </div>
      </div>
    </div>
  </div>
</section>

{t.slug === 'payload' && payloads.length > 0 && (
  <section class="paper">
    <div class="wrap">
      <div class="shead">
        <div><h2>{template.payloads.headline}</h2></div>
      </div>
      <div class="cards c2">
        {payloads.map((p) => (
          <a class="card" href={`/payloads/${p.data.slug}`}>
            <div>
              <h3>{p.data.name}</h3>
              <p>{p.data.comp} {p.data.year}. {p.data.summary}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<section>
  <div class="wrap">
    <div class="shead">
      <div><h2>{template.others.headline}</h2></div>
      <p>{template.others.lede}</p>
    </div>
    <div class="cards c3">
      {others.map((x) => (
        <a class="card" href={`/subteams/${x.data.slug}`}>
          <div><h3>{x.data.name}</h3><p>{x.data.blurb}</p></div>
        </a>
      ))}
    </div>

    <div class="shead shead--follow">
      <div><h2>{template.leads.headline}</h2></div>
      <p>{template.leads.lede}</p>
    </div>
    {t.teamPhoto ? (
      <figure class="team-shot">
        <img src={t.teamPhoto} alt={t.teamPhotoAlt || ''} width="1800" height="1440" loading="lazy" />
      </figure>
    ) : null}
    <div class={`cards ${leadCols}`}>
      {leads.length ? leads.map((lead) => (
        <div class="card"><div>
          <h3>{lead.name}</h3>
          <p>
            {lead.programme && lead.year ? (
              <>{lead.year} · {lead.programme}. </>
            ) : (
              <TodoBadge label="programme, year, and what they work on" />
            )}
            {' '}<a class="link-underline" href={mailHref()}>Email</a>
          </p>
        </div></div>
      )) : (
        <div class="card"><div>
          <h3>TODO: name</h3>
          <p>Year and programme. One sentence on what they work on.</p>
        </div></div>
      )}
      <a class="card" href="/join">
        <div>
          <h3>{template.leads.recruiting.headline}</h3>
          <p>{template.leads.recruiting.body}</p>
        </div>
      </a>
    </div>
  </div>
</section>

<CtaBand />
</BaseLayout>
