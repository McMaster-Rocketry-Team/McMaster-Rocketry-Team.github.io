---
import PageHead from '../../components/PageHead.astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import SubteamCards from '../../components/SubteamCards.astro';
import { subteamsHeadline } from '../../lib/copy';
import pages from '../../data/pages.json';

const page = pages.subteams.index;
const subteams = await getCollection('subteams');
const headline = subteamsHeadline(subteams.length, page.headline);
---

<BaseLayout
  title={page.title}
  description={page.description}
  current="/subteams"
  reviewLocked={Array.from({ length: 23 }, (_, i) => i)}
>
<PageHead title={headline} lede={page.lede} />

<section class="paper">
  <div class="wrap">
    <div class="shead">
      <div><h2>{page.section.headline}</h2></div>
      <p>{page.section.lede}</p>
    </div>
    <SubteamCards />
  </div>
</section>

<CtaBand />
</BaseLayout>
