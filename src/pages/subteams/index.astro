---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import SubteamCards from '../../components/SubteamCards.astro';
import { subteamsHeadline } from '../../lib/copy';
import pages from '../../data/pages.json';

const page = pages.subteams.index;
const subteams = await getCollection('subteams');
const headline = subteamsHeadline(subteams.length, page.headline);
---

<BaseLayout
  title={page.title}
  description={page.description}
  current="/subteams"
  reviewLocked={Array.from({ length: 23 }, (_, i) => i)}
>
<header class="phead">
  <span class="crosshair tl" aria-hidden="true"></span>
  <span class="crosshair br" aria-hidden="true"></span>
  <div class="wrap">
    <div class="tag">{page.tag}</div>
    <h1 set:html={headline.replace('\n', '<br>')} />
    <p class="lede">{page.lede}</p>
  </div>
</header>

<section class="paper">
  <div class="wrap">
    <div class="shead">
      <div><div class="tag">{page.section.tag}</div><h2 set:html={page.section.headline.replace('\n', '<br>')} /></div>
      <p>{page.section.lede}</p>
    </div>
    <SubteamCards />
  </div>
</section>

<CtaBand />
</BaseLayout>
