---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FleetLineup from '../components/FleetLineup.astro';
import FleetStat from '../components/FleetStat.astro';
import SubteamCards from '../components/SubteamCards.astro';
import CtaBand from '../components/CtaBand.astro';
import { numberWord } from '../lib/site';

const vehicles = await getCollection('vehicles');
const years = vehicles.map((v) => v.data.year);
const yearSpan = Math.max(...years) - Math.min(...years) + 1;
const noRecordCount = vehicles.filter((v) => !v.data.apogee).length;
const vCountWord = numberWord(vehicles.length);
const yearSpanWord = numberWord(yearSpan);
const noRecordWord = numberWord(noRecordCount);
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---

<BaseLayout
  title="Higher"
  description="McMaster Rocketry Team: student-built rockets from Hamilton, Ontario. 33,584 feet and climbing."
  current="/"
>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <filter id="duo" color-interpolation-filters="sRGB">
    <feColorMatrix type="matrix"
      values="0.2126 0.7152 0.0722 0 0
              0.2126 0.7152 0.0722 0 0
              0.2126 0.7152 0.0722 0 0
              0 0 0 1 0"/>
    {/* Straight identity table on top of the luminance matrix above: true
        grayscale, not a duotone remap. The two-stop red/black ramp this used
        to carry compressed the whole video into one flat colour wash. The
        footage itself needs to read as footage: the red/black palette comes
        from .heroveil sitting on top of it instead. */}
    <feComponentTransfer>
      <feFuncR type="table" tableValues="0 1"/>
      <feFuncG type="table" tableValues="0 1"/>
      <feFuncB type="table" tableValues="0 1"/>
    </feComponentTransfer>
  </filter>
</defs></svg>

<header class="hero">
  <span class="crosshair tl" aria-hidden="true"></span>
  <span class="crosshair br" aria-hidden="true"></span>
  <video class="bgvid" id="bgvid" autoplay muted loop playsinline preload="metadata"
         aria-hidden="true" tabindex="-1" poster="/media/hero-poster.jpg" data-src-sm="/media/hero-720.mp4" data-src-lg="/media/hero.mp4">
    <source src="/media/hero-720.mp4" type="video/mp4" />
  </video>
  <div class="heroveil"></div>
  <div class="wrap hero-in">
    <div class="phase"><b>Osiris · Launch Canada 2026</b><i></i></div>
    <h1 class="bignum"><span class="vh">McMaster Rocketry Team, highest flight to date: </span><span class="n">33,584</span> <span class="u">ft</span></h1>
    <div class="subline">
      <p>That is how high a rocket built by undergraduates went. Mach 1.92,
         {vCountWord} vehicles in {yearSpanWord} years,
         every part designed, built and flown by students.</p>
      <div class="who">McMaster University<br>Hamilton, Ontario</div>
    </div>
    <div class="btnrow">
      <a class="btn solid" href="/join">Join the team</a>
      <a class="btn" href="/rockets">See the rockets</a>
    </div>
  </div>
  <button class="vidtoggle" id="vidtoggle">Pause video</button>
</header>

<section class="paper fleet" id="fleet">
  <span class="crosshair tl" aria-hidden="true"></span>
  <span class="crosshair br" aria-hidden="true"></span>
  <div class="wrap">
    <div class="shead">
      <div>
        <div class="tag">The fleet</div>
        <h2>Every rocket,<br>by how high it got.</h2>
      </div>
      <p>{vCountWord} vehicles in {yearSpanWord} years.
         {cap(noRecordWord)} of them flew before we kept records this good
         (drawn as gaps on the chart, not filled in with a guess).</p>
      <div class="statline"><FleetStat /></div>
    </div>
    <FleetLineup />
    <p style="margin:22px 0 0;font-size:13.5px;color:var(--muted-on-paper)">
      &ldquo;No verified record&rdquo; means exactly that: the vehicle flew, but we
      have no instrumented figure we are willing to publish. The flag is a
      published figure we have not been able to verify.
    </p>
    <div class="btnrow"><a class="btn" href="/rockets">All {vCountWord} vehicles</a></div>
  </div>
</section>

<section id="subs">
  <div class="wrap">
    <div class="shead">
      <div>
        <div class="tag">Subteams</div>
        <h2>One airframe, seven subteams.</h2>
      </div>
      <p>Every part of the vehicle, and everything around it, is owned by a student subteam.
         One of them needs no engineering background at all.</p>
    </div>
    <SubteamCards />
  </div>
</section>

<CtaBand />
</BaseLayout>
