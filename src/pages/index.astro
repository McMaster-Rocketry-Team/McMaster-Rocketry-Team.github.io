---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FleetLineup from '../components/FleetLineup.astro';
import FleetStat from '../components/FleetStat.astro';
import PayloadLineup from '../components/PayloadLineup.astro';
import PayloadStat from '../components/PayloadStat.astro';
import SubteamCards from '../components/SubteamCards.astro';
import CtaBand from '../components/CtaBand.astro';
import { fill, payloadsHeadline, subteamsHeadline } from '../lib/copy';
import { numberWord } from '../lib/site';
import site from '../data/site.json';
import pages from '../data/pages.json';
import hadfield from '../data/chris-hadfield.json';

const home = pages.home;
const vehicles = await getCollection('vehicles');
const payloads = await getCollection('payloads');
const subteams = await getCollection('subteams');
const highestFlight = vehicles.reduce<(typeof vehicles)[number]['data'] | null>((best, { data: v }) => {
  return v.apogee && (!best || v.apogee > (best.apogee ?? 0)) ? v : best;
}, null);
const years = vehicles.map((v) => v.data.year);
const yearSpan = Math.max(...years) - Math.min(...years) + 1;
const vCountWord = numberWord(vehicles.length);
const yearSpanWord = numberWord(yearSpan);
const pCountWord = numberWord(payloads.length);
const pWins = payloads.filter((p) => p.data.result?.startsWith('1st')).length;
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const siteUrl = Astro.site ?? new URL('https://macrocketry.ca');
const logoUrl = new URL('/brand/logo-mark-white-red.png', siteUrl);
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: siteUrl.href,
  logo: {
    '@type': 'ImageObject',
    url: logoUrl.href,
    width: site.logo.width,
    height: site.logo.height,
  },
  email: site.email,
  sameAs: [site.social.instagram, site.social.discord, site.social.linkedin].filter(Boolean),
};
const heroDescription = highestFlight
  ? `Highest flight: ${highestFlight.apogee!.toLocaleString()} ft.`
  : 'Highest flight: record pending.';
const fleetCountNote = fill(home.fleet.countNote, { count: cap(vCountWord), years: yearSpanWord });
const subteamsHeadlineText = subteamsHeadline(subteams.length, home.subteams.headline);
---

<BaseLayout
  title={site.tagline}
  description={`McMaster Rocketry Team: student-built rockets from Hamilton, Ontario. ${heroDescription}`}
  current="/"
  reviewLocked={Array.from({ length: 36 }, (_, i) => i)}
>
<script type="application/ld+json" is:inline set:html={JSON.stringify(orgJsonLd)} />
<header class="hero">
  <span class="crosshair tl" aria-hidden="true"></span>
  <span class="crosshair br" aria-hidden="true"></span>
  <video class="bgvid" id="bgvid" muted loop playsinline preload="metadata"
         aria-hidden="true" tabindex="-1" poster="/media/hero-poster.jpg" data-src-sm="/media/hero-720.mp4" data-src-lg="/media/hero.mp4">
    <source src="/media/hero-720.mp4" type="video/mp4" />
  </video>
  <div class="wrap hero-in">
    <div class="herobox">
      <div class="lockup lockup--hero">
        <p class="lockup-name">{site.name}</p>
        <p class="lockup-tag">{site.tagline}</p>
      </div>
      <h1 class="bignum"><span class="vh">{home.hero.apogeeLabel}</span><span class="n">{highestFlight?.apogee?.toLocaleString() ?? '—'}</span> <span class="u">ft</span></h1>
      <div class="subline">
        <p>{highestFlight ? `${highestFlight.name} · ${highestFlight.comp} ${highestFlight.year}. ${home.hero.flightEver}` : home.hero.flightEver}<br>{cap(vCountWord)} vehicles in {yearSpanWord} years: {home.hero.fleetBlurb}</p>
        <div class="who">{site.org}<br>{site.city}</div>
      </div>
      <div class="btnrow">
        <a class="btn solid" href="/join">{home.hero.cta.join}</a>
        <a class="btn" href="/rockets">{home.hero.cta.rockets}</a>
      </div>
    </div>
  </div>
  <button class="vidtoggle" id="vidtoggle">{site.a11y.pauseVideo}</button>
</header>

<section id="hadfield">
  <div class="wrap">
    <div class="shead">
      <div>
        <div class="tag">{hadfield.tag}</div>
        <h2>{hadfield.headline[0]}<br>{hadfield.headline[1]}</h2>
      </div>
      <p>{hadfield.lede}</p>
    </div>
    <div class="gallery">
      {hadfield.photos.map((photo) => (
        <figure>
          <div class="ph" style={photo.ratio ? `--ph-ratio:${photo.ratio}` : undefined}>
            <img src={photo.src} alt={photo.alt} loading="lazy" />
          </div>
          {photo.caption && <figcaption>{photo.caption}</figcaption>}
        </figure>
      ))}
    </div>
    <div class="btnrow"><a class="btn" href={hadfield.cta.href}>{hadfield.cta.label}</a></div>
  </div>
</section>

<section class="paper fleet" id="fleet">
  <span class="crosshair tl" aria-hidden="true"></span>
  <span class="crosshair br" aria-hidden="true"></span>
  <div class="wrap">
    <div class="shead">
      <div>
        <div class="tag">{home.fleet.tag}</div>
        <h2>{home.fleet.headline[0]}<br>{home.fleet.headline[1]}</h2>
      </div>
      <p>{fleetCountNote}</p>
      <div class="statline"><FleetStat /></div>
    </div>
    <FleetLineup />
    <div class="btnrow"><a class="btn" href="/rockets">{fill(home.fleet.cta, { count: vCountWord })}</a></div>
  </div>
</section>

<section class="paper fleet" id="payloads">
  <span class="crosshair tl" aria-hidden="true"></span>
  <span class="crosshair br" aria-hidden="true"></span>
  <div class="wrap">
    <div class="shead">
      <div>
        <div class="tag">{home.payloads.tag}</div>
        <h2>{payloadsHeadline(payloads.length, pWins)}</h2>
      </div>
      <p>{cap(pCountWord)} payloads flown{pWins === payloads.length && payloads.length > 0 ? home.payloads.allWinsNote : ''}. {home.payloads.ledeSuffix}</p>
      <div class="statline"><PayloadStat /></div>
    </div>
    <PayloadLineup />
    <div class="btnrow"><a class="btn" href="/payloads">{fill(home.payloads.cta, { count: pCountWord })}</a></div>
  </div>
</section>

<section id="subs">
  <div class="wrap">
    <div class="shead">
      <div>
        <div class="tag">{home.subteams.tag}</div>
        <h2 set:html={subteamsHeadlineText.replace('\n', '<br>')} />
      </div>
      <p>{home.subteams.lede}</p>
    </div>
    <SubteamCards />
  </div>
</section>

<CtaBand />
</BaseLayout>
