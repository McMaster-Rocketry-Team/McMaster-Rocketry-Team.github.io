---
import PageHead from '../../components/PageHead.astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FleetLineup from '../../components/FleetLineup.astro';
import FleetStat from '../../components/FleetStat.astro';
import CtaBand from '../../components/CtaBand.astro';
import { fill } from '../../lib/copy';
import { numberWord } from '../../lib/site';
import pages from '../../data/pages.json';

const page = pages.rockets.index;
const vehicles = await getCollection('vehicles');
const years = vehicles.map((v) => v.data.year);
const yearSpan = Math.max(...years) - Math.min(...years) + 1;
const vCountWord = numberWord(vehicles.length);
const yearSpanWord = numberWord(yearSpan);
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const headline = fill(page.headline, { count: cap(vCountWord), years: cap(yearSpanWord) });
---

<BaseLayout
  title={page.title}
  description={page.description}
  current="/rockets"
  reviewLocked={Array.from({ length: 6 }, (_, i) => i)}
>
<PageHead title={headline} lede={page.lede} />

<section class="paper fleet">
  <div class="wrap">
    <div class="shead">
      <div><h2>{page.section.headline}</h2></div>
      <div class="statline"><FleetStat /></div>
    </div>
    <FleetLineup />
  </div>
</section>

<CtaBand />
</BaseLayout>
