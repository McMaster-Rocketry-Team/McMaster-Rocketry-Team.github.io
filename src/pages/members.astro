---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import LeadCard from '../components/LeadCard.astro';
import members from '../data/members.json';

const subteams = await getCollection('subteams');
const subteamOrder = new Map(subteams.map(({ data }, i) => [data.slug, i]));

function leadSortKey(lead: (typeof members.leads)[number]) {
  if (lead.subteam == null) return subteams.length;
  return subteamOrder.get(lead.subteam) ?? subteams.length;
}

const execRoles = new Set([
  'President',
  'Project manager',
]);
const executives = members.leads.filter((m) => execRoles.has(m.role));
const subteamLeads = members.leads
  .map((m, i) => ({ m, i }))
  .filter(({ m }) => !execRoles.has(m.role))
  .sort((a, b) => {
    if (a.m.name === 'Nick Phan') return 1;
    if (b.m.name === 'Nick Phan') return -1;
    const bySubteam = leadSortKey(a.m) - leadSortKey(b.m);
    if (bySubteam !== 0) return bySubteam;
    return a.i - b.i;
  })
  .map(({ m }) => m);
---

<BaseLayout
  title="Members"
  description="The students who build and fly McMaster Rocketry's vehicles."
  current="/members"
  reviewLocked={Array.from({ length: 79 }, (_, i) => i)}
>
<header class="phead">
  <span class="crosshair tl" aria-hidden="true"></span>
  <span class="crosshair br" aria-hidden="true"></span>
  <div class="wrap">
    <div class="tag">Members</div>
    <h1>The people<br>who build it.</h1>
    <p class="lede">Over 100 students across seven subteams and every faculty on campus. These are the leads. The rest of the team is on the subteam pages.</p>
  </div>
</header>

<section class="paper">
  <div class="wrap">
    <div class="shead">
      <div><div class="tag">2026&ndash;27 leadership</div><h2>Leads.</h2></div>
    </div>

    <div class="roster-block">
      <p class="roster-label">Executive</p>
      <div class="roster roster--exec">
        {executives.map((m) => (
          <LeadCard name={m.name} role={m.role} programme={m.programme} year={m.year} photo={m.photo} />
        ))}
      </div>
    </div>

    <div class="roster-block">
      <p class="roster-label">Subteam leads</p>
      <div class="roster">
        {subteamLeads.map((m) => (
          <LeadCard name={m.name} role={m.role} programme={m.programme} year={m.year} photo={m.photo} />
        ))}
      </div>
    </div>

  </div>
</section>

<section>
  <div class="wrap">
    <div class="shead">
      <div><div class="tag">Who we are</div><h2>Not only engineers.</h2></div>
      <p>The team runs on more than airframes. These are the numbers behind the roster.</p>
    </div>
    <dl class="dl">
      {members.stats.map((s) => (
        <div>
          <dt>{s.label}</dt>
          {s.value ? <dd>{s.value}<small>{s.note}</small></dd> : <dd class="nodata">TODO<small>{s.note}</small></dd>}
        </div>
      ))}
    </dl>
    <div class="prose prose--follow">
      <p>Most of the people on this page had never touched a rocket before joining. Several
        are not in engineering at all. The operations leads run sponsorship, the
        budget and everything we do on campus.</p>
    </div>
    <div class="btnrow"><a class="btn solid" href="/join">Join them</a></div>
  </div>
</section>

<CtaBand />
</BaseLayout>
