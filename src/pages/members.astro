---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import LeadCard from '../components/LeadCard.astro';
import { membersLede } from '../lib/copy';
import members from '../data/members.json';

const page = members.page;
const subteams = await getCollection('subteams');
const subteamOrder = new Map(subteams.map(({ data }, i) => [data.slug, i]));
const execRoles = new Set(members.executiveRoles);
const sortLast = new Set(members.leadSortLast);

function leadSortKey(lead: (typeof members.leads)[number]) {
  if (lead.subteam == null) return subteams.length;
  return subteamOrder.get(lead.subteam) ?? subteams.length;
}

const executives = members.leads.filter((m) => execRoles.has(m.role));
const subteamLeads = members.leads
  .map((m, i) => ({ m, i }))
  .filter(({ m }) => !execRoles.has(m.role))
  .sort((a, b) => {
    if (sortLast.has(a.m.name)) return 1;
    if (sortLast.has(b.m.name)) return -1;
    const bySubteam = leadSortKey(a.m) - leadSortKey(b.m);
    if (bySubteam !== 0) return bySubteam;
    return a.i - b.i;
  })
  .map(({ m }) => m);
---

<BaseLayout
  title={page.title}
  description={page.description}
  current="/members"
  reviewLocked={Array.from({ length: 79 }, (_, i) => i)}
>
<header class="phead">
  <span class="crosshair tl" aria-hidden="true"></span>
  <span class="crosshair br" aria-hidden="true"></span>
  <div class="wrap">
    <div class="tag">{page.tag}</div>
    <h1>{page.headline[0]}<br>{page.headline[1]}</h1>
    <p class="lede">{membersLede(page.lede, members.stats)}</p>
  </div>
</header>

<section class="paper">
  <div class="wrap">
    <div class="shead">
      <div><div class="tag">{page.leadershipTerm}</div><h2>Leads.</h2></div>
    </div>

    <div class="roster-block">
      <p class="roster-label">{page.rosterLabels.executive}</p>
      <div class="roster roster--exec">
        {executives.map((m) => (
          <LeadCard name={m.name} role={m.role} programme={m.programme} year={m.year} photo={m.photo} />
        ))}
      </div>
    </div>

    <div class="roster-block">
      <p class="roster-label">{page.rosterLabels.subteamLeads}</p>
      <div class="roster">
        {subteamLeads.map((m) => (
          <LeadCard name={m.name} role={m.role} programme={m.programme} year={m.year} photo={m.photo} />
        ))}
      </div>
    </div>

  </div>
</section>

<section>
  <div class="wrap">
    <div class="shead">
      <div><div class="tag">{page.about.tag}</div><h2>{page.about.headline}</h2></div>
      <p>{page.about.lede}</p>
    </div>
    <dl class="dl">
      {members.stats.map((s) => (
        <div>
          <dt>{s.label}</dt>
          {s.value ? <dd>{s.value}<small>{s.note}</small></dd> : <dd class="nodata">TODO<small>{s.note}</small></dd>}
        </div>
      ))}
    </dl>
    <div class="prose prose--follow">
      <p>{page.about.body}</p>
    </div>
    <div class="btnrow"><a class="btn solid" href="/join">{page.cta}</a></div>
  </div>
</section>

<CtaBand />
</BaseLayout>
